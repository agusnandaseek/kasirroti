# Local Supabase (default ports)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL used for tracking links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to derive tracking tokens (minimum 32 random bytes, base64url).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRACKING_TOKEN_PEPPER=

# First admin bootstrap (scripts/bootstrap-admin.mjs). Do not commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional credentials for scripts/verify-routes.mjs (leave empty to skip role checks).
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=
VERIFY_CASHIER_EMAIL=
VERIFY_CASHIER_PASSWORD=
